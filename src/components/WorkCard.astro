---
// Project card: big photo, context and status line, title, a few tags.
// Used on the home page grid and on /projects (where data-categories drives the filter).
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  // 'wide' spans the full grid width with a letterbox image.
  wide?: boolean;
  eager?: boolean;
}
const { project, wide = false, eager = false } = Astro.props;
const { data } = project;
const pic = data.card === 'text' ? undefined : (data.cardImage ?? data.cover ?? data.gallery[0]);
const matte = pic && 'matte' in pic ? pic.matte : undefined;
const href = `/projects/${project.id}`;
---

<article class:list={['work-card', { wide, compact: !pic }]} data-categories={data.categories.join(',')} data-tilt>
  {
    pic ? (
      <a class:list={['shot', { matted: matte }]} href={href} tabindex="-1" aria-hidden="true" style={matte ? `--matte: ${matte}` : undefined}>
        <Image
          src={pic.src}
          alt=""
          widths={wide ? [800, 1200, 1700] : [560, 900, 1200]}
          sizes={wide ? '(max-width: 1720px) 100vw, 1680px' : '(max-width: 760px) 100vw, 50vw'}
          quality={88}
          loading={eager ? 'eager' : 'lazy'}
        />
      </a>
    ) : (
      // No photo: a short text-only card instead of an empty image box.
      null
    )
  }
  <div class="text">
    <p class="meta-line"><span class="ctx">{data.context}</span>{data.status && <span class="status">{data.status}</span>}</p>
    <h3><a href={href}>{data.title}</a></h3>
    {!pic && <p class="blurb">{data.summary}</p>}
    <ul class="tags">
      {data.disciplines.slice(0, 3).map((d) => <li>{d}</li>)}
    </ul>
  </div>
</article>

<style>
  .work-card {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: rgb(16 19 22 / 0.55);
  }
  .work-card:hover {
    background: rgb(16 19 22 / 0.8);
  }
  /* Hover: the whole card leans toward the cursor (script in Base.astro) and a soft
     green glow lifts it off the page. */
  .work-card {
    transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.35s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .work-card:global(.tilting) {
    transition: border-color 0.25s ease, background 0.25s ease, box-shadow 0.35s ease, transform 0.08s linear;
  }
  .work-card:hover {
    border-color: rgb(126 240 196 / 0.35);
    box-shadow: 0 24px 50px -16px rgb(126 240 196 / 0.45), 0 8px 20px -12px rgb(0 0 0 / 0.6);
  }
  .work-card[hidden] {
    display: none;
  }
  .shot {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--img-bg);
  }
  .wide .shot {
    aspect-ratio: 21 / 9;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-card:hover .shot :global(img) {
    transform: scale(1.03);
  }
  .matted {
    background: var(--matte);
  }
  .matted :global(img) {
    object-fit: contain;
    padding: 6%;
  }
  .compact {
    align-self: start;
    padding-top: 1.1rem;
  }
  .blurb {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .text {
    padding-inline: 0.4rem;
    display: grid;
    gap: 0.45rem;
  }
  .meta-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.9rem;
    font-size: 0.85rem;
  }
  .ctx {
    color: var(--warm);
  }
  .status {
    color: var(--accent);
  }
  h3 {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.15;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
