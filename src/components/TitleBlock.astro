---
// Spec readout: a row of small labels over larger values, like an instrument panel.
// Used under project images and at the top of case studies.
interface Props {
  cells: { label: string; value: string }[];
}
const { cells } = Astro.props;
---

<dl class="readout" style={`--cols: ${cells.length}`}>
  {
    cells.map((c) => (
      <div class="cell">
        <dt>{c.label}</dt>
        <dd>{c.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .readout {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line-strong);
    font-family: var(--font-body);
  }
  .cell {
    padding-right: 1rem;
    min-width: 0;
  }
  .cell + .cell {
    padding-left: 1rem;
    border-left: 1px solid var(--line);
  }
  dt {
    font-size: 0.8rem;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  dd {
    margin: 0.15rem 0 0;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  @media (max-width: 640px) {
    .readout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 0;
    }
    .cell:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
