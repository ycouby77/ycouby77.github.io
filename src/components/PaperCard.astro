---
// Citation card for prior work a project builds on. Links out to the publisher
// (the paper itself is copyrighted, so it isn't hosted here).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  authors: string;
  venue: string;
  year: number;
  url: string;
  note: string;
  image?: ImageMetadata;
}
const { title, authors, venue, year, url, note, image } = Astro.props;
---

<a class="paper" href={url} target="_blank" rel="noopener">
  {image && <Image class="thumb" src={image} alt="" widths={[240, 480]} sizes="160px" />}
  <span class="body">
    <span class="venue">{venue}, {year}</span>
    <span class="title">{title}</span>
    <span class="authors">{authors}</span>
    <span class="note">{note}</span>
    <span class="cta">Read the paper on IEEE Xplore <Icon name="arrow-up-right" size={16} /></span>
  </span>
</a>

<style>
  .paper {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
  }
  .paper:hover {
    border-color: var(--accent);
    color: inherit;
  }
  .thumb {
    width: 160px;
    height: 120px;
    object-fit: contain;
    background: var(--img-bg);
  }
  .body {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }
  .venue {
    font: 400 0.78rem/1.4 var(--font-mono);
    color: var(--muted);
  }
  .title {
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .authors {
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .note {
    color: var(--muted);
    font-size: 0.88rem;
    margin-top: 0.25rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.4rem;
    color: var(--accent);
    font-weight: 500;
    font-size: 0.9rem;
  }
  @media (max-width: 560px) {
    .paper {
      grid-template-columns: minmax(0, 1fr);
    }
    .thumb {
      width: 100%;
      height: 160px;
    }
  }
</style>
