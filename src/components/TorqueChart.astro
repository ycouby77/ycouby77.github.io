---
// Line chart of torque against coil current, drawn in the site's own style (via XYChart).
// Data are passed in by the page; nothing here is copied from a published figure.
import XYChart from './XYChart.astro';

interface Series {
  name: string;
  values: number[];
}
interface Props {
  // Coil current for each value, in amps.
  currents: number[];
  series: Series[];
  caption?: string;
}
const { currents, series, caption } = Astro.props;

const yMax = Math.ceil(Math.max(...series.flatMap((s) => s.values)) / 5) * 5;
const yTicks = Array.from({ length: yMax / 5 + 1 }, (_, i) => i * 5);
const xTicks = currents.filter((_, i) => i % 3 === 0);
const colors = ['var(--chart-b, #8fb4ff)', 'var(--accent)'];
---

<XYChart
  series={series.map((s, i) => ({ name: s.name, color: colors[i % colors.length], points: s.values.map((v, j) => [currents[j], v]) }))}
  xLabel="Coil current (A)"
  yLabel="Torque (N·mm)"
  xTicks={xTicks}
  yTicks={yTicks}
  labels="end"
  ariaLabel={`Torque against coil current for ${series.map((s) => s.name).join(' and ')}`}
  caption={caption}
>
  <slot />
</XYChart>
