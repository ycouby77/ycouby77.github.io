---
// Interactive 3D viewer for project CAD. three.js is only downloaded once the
// viewer scrolls near the screen, so pages without one (or visitors who never
// scroll to it) pay nothing.
interface Props {
  title: string;
  // Bare: just the canvas (no header, part picker or caption), for embedding in a hero.
  bare?: boolean;
  // Bare + several models: auto-advance every N seconds (0 = never). Arrows are always shown.
  cycle?: number;
  note?: string;
  models: { label: string; src: string; caption?: string; rotation?: [number, number, number]; finish?: 'original' | 'plastic'; explode?: boolean }[];
}
const { title, note, models, bare = false, cycle = 0 } = Astro.props;
---

<section class:list={['viewer', { bare }]} aria-label={title} data-viewer data-models={JSON.stringify(models)} data-cycle={cycle}>
  {
    !bare && (
      <div class="viewer-head">
        <h2 class="label">{title}</h2>
        <p class="hint">Drag to orbit. Click, then scroll to zoom.</p>
      </div>
    )
  }
  <div class="stage">
    <slot name="poster" />
    <canvas role="img" tabindex="0" aria-label={`3D model: ${models[0].label}. Drag to rotate; arrow keys pan.`}></canvas>
    <p class="status meta" aria-live="polite">Loading 3D viewer…</p>
    {
      bare && models.length > 1 && (
        <div class="nav">
          <button type="button" class="nav-btn" data-step="-1" aria-label="Previous model">&larr;</button>
          <button type="button" class="nav-btn" data-step="1" aria-label="Next model">&rarr;</button>
        </div>
      )
    }
  </div>
  <div class="bar" hidden={bare}>
    {
      models.length > 1 && (
        <div class="parts" role="group" aria-label="Choose a part">
          {models.map((m, i) => (
            <button type="button" data-index={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              {m.label}
            </button>
          ))}
        </div>
      )
    }
    <label class="explode" hidden data-explode-wrap>
      <span>Explode</span>
      <input type="range" min="0" max="1" step="0.01" value="0" data-explode aria-label="Explode the assembly into its parts" />
    </label>
    <p class="caption">{models[0].caption ?? ''}</p>
  </div>
  {note && !bare && <p class="note">{note}</p>}
</section>

<script>
  import type { Mesh, Object3D } from 'three';

  type ModelSpec = { label: string; src: string; caption?: string; rotation?: [number, number, number]; finish?: 'original' | 'plastic'; explode?: boolean };

  async function mount(root: HTMLElement) {
    const models: ModelSpec[] = JSON.parse(root.dataset.models ?? '[]');
    const canvas = root.querySelector('canvas')!;
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const status = root.querySelector<HTMLElement>('.status')!;
    const caption = root.querySelector<HTMLElement>('.caption')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.parts button')];

    const THREE = await import('three');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { STLLoader } = await import('three/examples/jsm/loaders/STLLoader.js');
    const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
    // Models are meshopt-compressed by `npm run model:optimize`.
    const { MeshoptDecoder } = await import('three/examples/jsm/libs/meshopt_decoder.module.js');
    const { toCreasedNormals } = await import('three/examples/jsm/utils/BufferGeometryUtils.js');
    // CAD look: smooth shading on curved faces, hard edges where faces meet at > 30 degrees.
    const CREASE = THREE.MathUtils.degToRad(30);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 10000);
    scene.add(new THREE.HemisphereLight(0xffffff, 0x2a2c30, 1.6));
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(1, 1.4, 1.2);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xdfe6ff, 0.8);
    rim.position.set(-1.2, 0.4, -1);
    scene.add(rim);

    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.listenToKeyEvents(canvas);
    // Wheel zoom only while the viewer is "engaged", so scrolling past it never gets hijacked.
    controls.enableZoom = false;
    canvas.addEventListener('pointerdown', () => (controls.enableZoom = true));
    canvas.addEventListener('pointerleave', () => (controls.enableZoom = false));
    canvas.addEventListener('blur', () => (controls.enableZoom = false));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    controls.autoRotate = !reduceMotion;
    controls.autoRotateSpeed = 1.2;
    canvas.addEventListener('pointerdown', () => (controls.autoRotate = false), { once: true });

    // Printed parts read as matte plastic; GLB files keep their own materials.
    const plastic = new THREE.MeshStandardMaterial({ color: 0xd9dadc, roughness: 0.55, metalness: 0.05 });
    // Faint phosphor-green measuring grid under the model.
    const grid = new THREE.GridHelper(1, 20, 0x7ef0c4, 0x2b6b58);
    const gridMats = Array.isArray(grid.material) ? grid.material : [grid.material];
    gridMats.forEach((m) => {
      m.transparent = true;
      m.opacity = 0.32;
    });
    scene.add(grid);

    let current: Object3D | null = null;
    const cache = new Map<string, Object3D>();

    async function load(spec: ModelSpec): Promise<Object3D> {
      const hit = cache.get(spec.src);
      if (hit) return hit;
      let obj: Object3D;
      if (/\.stl$/i.test(spec.src)) {
        const geo = await new STLLoader().loadAsync(spec.src);
        obj = new THREE.Mesh(toCreasedNormals(geo, CREASE), plastic);
        // SolidWorks exports Y-up already; STLs from other tools may need rotating here.
      } else {
        obj = (await new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).loadAsync(spec.src)).scene;
        if (spec.finish === 'plastic') {
          obj.traverse((o) => {
            const mesh = o as Mesh;
            if (!mesh.isMesh) return;
            // Converted CAD exports often ship without normals (renders solid black);
            // rebuild them with creases so sharp edges stay sharp.
            mesh.geometry = toCreasedNormals(mesh.geometry, CREASE);
            mesh.material = plastic;
          });
        }
      }
      if (spec.explode) prepareExplode(obj);
      if (spec.rotation) {
        // Wrap so frame() can freely reposition the outer group.
        const [rx, ry, rz] = spec.rotation.map((d) => THREE.MathUtils.degToRad(d));
        obj.rotation.set(rx, ry, rz);
        const group = new THREE.Group();
        group.add(obj);
        obj = group;
      }
      cache.set(spec.src, obj);
      return obj;
    }

    function frame(obj: Object3D) {
      obj.position.set(0, 0, 0);
      obj.updateMatrixWorld(true);
      const box = new THREE.Box3().setFromObject(obj);
      const size = box.getSize(new THREE.Vector3());
      const center = box.getCenter(new THREE.Vector3());
      // Sit the model on the grid, centred.
      obj.position.set(-center.x, -box.min.y, -center.z);
      const radius = size.length() / 2 || 1;
      grid.scale.setScalar(radius * 4);
      const dist = radius / Math.sin(THREE.MathUtils.degToRad(camera.fov / 2));
      camera.near = dist / 100;
      camera.far = dist * 100;
      // Three-quarter view from slightly above, close enough that the model fills the frame.
      camera.position.set(dist * 0.58, dist * 0.4, dist * 0.58);
      camera.updateProjectionMatrix();
      controls.target.set(0, size.y / 2, 0);
      controls.update();
    }

    // Exploded view: every part moves away from the assembly centre along its own
    // offset, so outer parts travel further (like a classic exploded drawing).
    type Part = { mesh: Object3D; home: InstanceType<typeof THREE.Vector3>; dir: InstanceType<typeof THREE.Vector3> };
    const explodeParts = new Map<Object3D, Part[]>();
    function prepareExplode(obj: Object3D) {
      obj.updateMatrixWorld(true);
      const centre = new THREE.Box3().setFromObject(obj).getCenter(new THREE.Vector3());
      const parts: Part[] = [];
      obj.traverse((o) => {
        if (!(o as Mesh).isMesh || !o.parent) return;
        const c = new THREE.Box3().setFromObject(o).getCenter(new THREE.Vector3());
        const offsetWorld = c.clone().sub(centre);
        // Express the world offset in the parent's local space.
        const a = o.parent.worldToLocal(c.clone());
        const b = o.parent.worldToLocal(c.clone().add(offsetWorld));
        parts.push({ mesh: o, home: o.position.clone(), dir: b.sub(a) });
      });
      explodeParts.set(obj, parts);
    }
    const explodeInput = root.querySelector<HTMLInputElement>('[data-explode]');
    const explodeWrap = root.querySelector<HTMLElement>('[data-explode-wrap]');
    function applyExplode(v: number) {
      const parts = current ? explodeParts.get(current.children.length === 1 && explodeParts.has(current.children[0]) ? current.children[0] : current) : undefined;
      parts?.forEach((p) => p.mesh.position.copy(p.home).addScaledVector(p.dir, v * 1.4));
    }
    explodeInput?.addEventListener('input', () => applyExplode(Number(explodeInput.value)));

    let index = 0;
    async function show(i: number) {
      index = i;
      const spec = models[i];
      root.dispatchEvent(new CustomEvent('viewerchange', { detail: { index: i }, bubbles: true }));
      status.textContent = `Loading ${spec.label}…`;
      status.hidden = false;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(i === j)));
      try {
        const obj = await load(spec);
        if (current) scene.remove(current);
        current = obj;
        scene.add(obj);
        frame(obj);
        canvas.setAttribute('aria-label', `3D model: ${spec.label}. Drag to rotate; arrow keys pan.`);
        caption.textContent = spec.caption ?? '';
        if (explodeWrap && explodeInput) {
          explodeWrap.hidden = !spec.explode;
          explodeInput.value = '0';
          applyExplode(0);
        }
        status.hidden = true;
        root.dataset.loaded = 'true';
      } catch {
        status.textContent = `Couldn't load ${spec.label}.`;
      }
    }

    function resize() {
      const { width, height } = stage.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(stage);
    resize();

    // Only render while the viewer is on screen.
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
    renderer.setAnimationLoop(() => {
      if (!visible) return;
      controls.update();
      renderer.render(scene, camera);
    });

    buttons.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.index))));

    // Hero carousel: arrows plus optional auto-advance. Any manual interaction stops
    // auto-advance for good; hovering pauses it; reduced motion disables it.
    const cycleSec = Number(root.dataset.cycle || 0);
    let auto = cycleSec > 0 && models.length > 1 && !reduceMotion;
    let hovering = false;
    const step = (d: number) => show((index + d + models.length) % models.length);
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
      b.addEventListener('click', () => {
        auto = false;
        step(Number(b.dataset.step));
      }),
    );
    stage.addEventListener('pointerenter', () => (hovering = true));
    stage.addEventListener('pointerleave', () => (hovering = false));
    canvas.addEventListener('pointerdown', () => (auto = false));
    if (auto) {
      setInterval(() => {
        if (auto && !hovering && visible && !document.hidden) step(1);
      }, cycleSec * 1000);
    }

    await show(0);
    // Warm the cache so switching models is instant.
    models.slice(1).forEach((m) => load(m).catch(() => {}));
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-viewer]')) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        mount(root).catch((err) => {
          console.error('3D viewer failed to start', err);
          const s = root.querySelector<HTMLElement>('.status');
          if (s) s.textContent = "Couldn't start the 3D viewer.";
        });
      },
      { rootMargin: '300px' },
    );
    io.observe(root);
  }
</script>

<style>
  .viewer {
    margin-top: 3rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: rgb(13 29 38 / 0.7);
  }
  .viewer.bare {
    margin: 0;
    border: 0;
    background: transparent;
  }
  .bare .stage {
    aspect-ratio: 4 / 3;
    background: none;
  }
  .bare .status {
    display: none;
  }
  /* Poster image shown until the model is ready. */
  .stage > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.5;
    transition: opacity 0.4s ease;
  }
  [data-loaded] .stage > :global(img) {
    opacity: 0;
  }
  .bar[hidden] {
    display: none;
  }
  .nav {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }
  .nav-btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    color: var(--ink);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .nav-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .viewer-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .viewer-head > * {
    margin: 0;
  }
  .hint {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    min-height: 280px;
    background: radial-gradient(ellipse at 50% 35%, var(--surface) 0%, var(--bg) 75%);
    cursor: grab;
    /* Vertical swipes scroll the page; horizontal drags and pinches go to the viewer. */
    touch-action: pan-y;
  }
  .stage:active {
    cursor: grabbing;
  }
  canvas {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  .status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    pointer-events: none;
  }
  .status[hidden] {
    display: none;
  }
  .bar {
    border-top: 1px solid var(--line-strong);
    padding: 0.75rem 1rem;
    display: grid;
    gap: 0.6rem;
  }
  .parts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .parts button {
    font: 500 0.7rem/1 var(--font-body);
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    min-height: 36px;
    padding: 0.45rem 0.7rem;
    cursor: pointer;
  }
  .parts button:hover {
    color: var(--ink);
    border-color: var(--muted);
  }
  .parts button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .caption {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .caption:empty {
    display: none;
  }
  .explode {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 360px;
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  .explode[hidden] {
    display: none;
  }
  .explode input {
    flex: 1;
    accent-color: var(--accent);
  }
  .note {
    margin: 0;
    padding: 0 1rem 0.75rem;
    color: var(--muted);
    font-size: 0.82rem;
  }
  @media (max-width: 640px) {
    .stage {
      aspect-ratio: 1 / 1;
    }
    .hint {
      display: none;
    }
  }
</style>
