---
// Small x/y chart drawn in the site's own style (inline SVG, so it stays sharp and
// follows the theme). Data are passed in by the page.
//
// Series kinds:
//   line    solid line through the points, with dots
//   dashed  dashed line, no dots (models, fits, ideal curves)
//   points  dots only, joined by a thin line
//   range   vertical bars, each point is [x, low, high]
// Labels: 'end' writes each series name at its last point (needs a wide right margin);
// 'legend' lists them under the chart instead (better when lines bunch together).
type Kind = 'line' | 'dashed' | 'points' | 'range';
interface Series {
  name: string;
  kind?: Kind;
  points: number[][];
  color?: string;
}
interface Props {
  series: Series[];
  xLabel: string;
  yLabel: string;
  xTicks: number[];
  yTicks: number[];
  // Decimal places for tick text (default: as written).
  xDecimals?: number;
  yDecimals?: number;
  // Horizontal reference line, e.g. a voltage limit.
  hline?: { y: number; label: string };
  labels?: 'end' | 'legend';
  ariaLabel: string;
  caption?: string;
}
const {
  series,
  xLabel,
  yLabel,
  xTicks,
  yTicks,
  xDecimals,
  yDecimals,
  hline,
  labels = 'legend',
  ariaLabel,
  caption,
} = Astro.props;

const W = 640;
const H = 400;
const m = { top: 20, right: labels === 'end' ? 122 : 24, bottom: 52, left: (yDecimals ?? 0) > 1 ? 62 : 54 };
const [x0, x1] = [Math.min(...xTicks), Math.max(...xTicks)];
const [y0, y1] = [Math.min(...yTicks), Math.max(...yTicks)];
const x = (v: number) => m.left + ((v - x0) / (x1 - x0)) * (W - m.left - m.right);
const y = (v: number) => H - m.bottom - ((v - y0) / (y1 - y0)) * (H - m.top - m.bottom);
const fmt = (t: number, d?: number) => (d === undefined ? String(+t.toFixed(6)) : t.toFixed(d));
const palette = ['var(--chart-b, #8fb4ff)', 'var(--accent)', 'var(--warm)', 'var(--muted)'];
const color = (s: Series, i: number) => s.color ?? palette[i % palette.length];
const path = (pts: number[][]) => pts.map(([px, py], i) => `${i === 0 ? 'M' : 'L'}${x(px).toFixed(1)} ${y(py).toFixed(1)}`).join(' ');
---

<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel}>
    {yTicks.map((t) => (
      <g>
        <line class="grid" x1={m.left} x2={W - m.right} y1={y(t)} y2={y(t)} />
        <text class="tick" x={m.left - 10} y={y(t)} text-anchor="end" dominant-baseline="middle">{fmt(t, yDecimals)}</text>
      </g>
    ))}
    {xTicks.map((t) => (
      <text class="tick" x={x(t)} y={H - m.bottom + 20} text-anchor="middle">{fmt(t, xDecimals)}</text>
    ))}
    <line class="axis" x1={m.left} x2={W - m.right} y1={y(y0)} y2={y(y0)} />
    <text class="axis-label" x={(m.left + W - m.right) / 2} y={H - 8} text-anchor="middle">{xLabel}</text>
    <text class="axis-label" transform={`translate(15 ${(m.top + H - m.bottom) / 2}) rotate(-90)`} text-anchor="middle">{yLabel}</text>
    {
      hline && (
        <g class="limit">
          <line x1={m.left} x2={W - m.right} y1={y(hline.y)} y2={y(hline.y)} />
          <text x={W - m.right - 6} y={y(hline.y) - 8} text-anchor="end">{hline.label}</text>
        </g>
      )
    }
    {series.map((s, i) => {
      const kind = s.kind ?? 'line';
      const last = s.points[s.points.length - 1];
      return (
        <g style={`color:${color(s, i)}`}>
          {kind === 'range' ? (
            s.points.map(([px, lo, hi]) => (
              <g class="range">
                <line x1={x(px)} x2={x(px)} y1={y(lo)} y2={y(hi)} />
                <line x1={x(px) - 6} x2={x(px) + 6} y1={y(lo)} y2={y(lo)} />
                <line x1={x(px) - 6} x2={x(px) + 6} y1={y(hi)} y2={y(hi)} />
              </g>
            ))
          ) : (
            <path class:list={['line', kind]} d={path(s.points)} />
          )}
          {(kind === 'line' || kind === 'points') && s.points.map(([px, py]) => <circle class="pt" cx={x(px)} cy={y(py)} r={kind === 'points' ? 4.5 : 3} />)}
          {labels === 'end' && (
            <text class="series" x={x(last[0]) + 10} y={y(last[1])} dominant-baseline="middle">
              {s.name}
            </text>
          )}
        </g>
      );
    })}
  </svg>
  {
    labels === 'legend' && (
      <ul class="legend">
        {series.map((s, i) => (
          <li style={`color:${color(s, i)}`}>
            <span class:list={['key', s.kind ?? 'line']} />
            <span class="name">{s.name}</span>
          </li>
        ))}
        {hline && (
          <li class="limit-key">
            <span class="key dashed" />
            <span class="name">{hline.label}</span>
          </li>
        )}
      </ul>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
  <slot />
</figure>

<style>
  .chart {
    margin: 1.75rem 0;
    display: grid;
    gap: 0.6rem;
    max-width: 52rem;
  }
  svg {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-body);
  }
  .grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .axis {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  .tick {
    fill: var(--muted);
    font-size: 14px;
  }
  .axis-label {
    fill: var(--ink-2);
    font-size: 15px;
  }
  .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .line.dashed {
    stroke-width: 2;
    stroke-dasharray: 7 6;
  }
  .line.points {
    stroke-width: 1.25;
    opacity: 0.6;
  }
  .range line {
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .pt {
    fill: currentColor;
  }
  .series {
    fill: currentColor;
    font-size: 15px;
    font-weight: 500;
  }
  .limit line {
    stroke: var(--warm);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
  }
  .limit text {
    fill: var(--warm);
    font-size: 14px;
  }
  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .legend .name {
    color: var(--ink-2);
  }
  .key {
    width: 22px;
    height: 0;
    border-top: 2.5px solid currentColor;
  }
  .key.dashed {
    border-top-style: dashed;
    border-top-width: 2px;
  }
  .key.points {
    width: 9px;
    height: 9px;
    border: 0;
    border-radius: 50%;
    background: currentColor;
  }
  .key.range {
    width: 2.5px;
    height: 14px;
    border: 0;
    background: currentColor;
  }
  .limit-key {
    color: var(--warm);
  }
  figcaption,
  .chart :global(p) {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>
