---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TitleBlock from '../components/TitleBlock.astro';
import ModelViewer from '../components/ModelViewer.astro';
import Icon from '../components/Icon.astro';
import HeroScene from '../components/HeroScene.astro';
import Contours from '../components/Contours.astro';
import WorkCard from '../components/WorkCard.astro';
import RoleCard from '../components/RoleCard.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { profile, heroModels, experience, leadership } from '../data/profile';
import { teaser, headshot, teaserPhotos } from '../data/about';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
// Home grid: every ongoing project, then the first three past ones. Everything is on /projects.
const ongoing = projects.filter((p) => p.data.ongoing);
const homeGroups = [
  { title: 'Ongoing projects', items: ongoing },
  { title: 'Past projects', items: projects.filter((p) => !p.data.ongoing).slice(0, 3) },
].filter((g) => g.items.length > 0);
// Hero carousel: each configured project's first 3D model, swapped for the lighter file.
const heroItems = heroModels.flatMap(({ project: id, src }) => {
  const project = projects.find((p) => p.id === id);
  const model = project?.data.viewer?.models[0];
  if (!project || !model) return [];
  return [{ project, model: { ...model, label: project.data.title, src }, num: String(featured.indexOf(project) + 1).padStart(2, '0') }];
});
// Experience cards: current roles first, then the rest in order.
const roles = [...experience, ...leadership].sort((a, b) => Number(b.status === 'Current') - Number(a.status === 'Current'));
// Headline: last two words set in italic (same words, just emphasis).
const words = profile.headline.split(' ');
const headLead = words.slice(0, -2).join(' ');
const headTail = words.slice(-2).join(' ');
---

<Base>
  <div class="hero-band">
  <HeroScene />
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow avail">{profile.availability ?? profile.name}</p>
      <h1>{headLead} <em>{headTail}</em></h1>
      <p class="intro">{profile.tagline}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#work">View work</a>
        <a class="btn" href="/resume">Resume</a>
        <a class="btn icon-btn" href={profile.linkedin} rel="me noopener" target="_blank">
          <Icon name="brand-linkedin" /> LinkedIn
        </a>
      </div>
    </div>
    {
      heroItems.length > 0 && (
        <figure class="hero-media" data-hero-media>
          <ModelViewer title="Featured builds in 3D" models={heroItems.map((h) => h.model)} bare cycle={9} />
          <figcaption>
            {heroItems.map((h, i) => (
              <a href={`/projects/${h.project.id}`} class="hero-caption" data-hero-caption hidden={i !== 0}>
                <TitleBlock
                  cells={[
                    { label: 'Sheet', value: h.num },
                    { label: 'Project', value: h.project.data.title },
                    { label: 'Model', value: 'Live 3D: drag to rotate' },
                  ]}
                />
              </a>
            ))}
          </figcaption>
        </figure>
      )
    }
  </section>
  </div>

  <section id="work" class="section wrap work">
    <Contours peaks={[[0.95, 0.06], [0.02, 0.55]]} />
    <div class="section-head">
      <h2 class="section-title">Projects</h2>
      <a class="see-all" href="/projects">All {projects.length} projects <Icon name="arrow-right" size={16} /></a>
    </div>
    {
      homeGroups.map((g, gi) => (
        <div class="card-group">
          <h3 class="group-title">{g.title}</h3>
          <div class="card-grid">
            {g.items.map((p, i) => <WorkCard project={p} eager={gi === 0 && i < 3} />)}
          </div>
        </div>
      ))
    }
  </section>

  <section id="experience" class="section wrap">
    <div class="section-head">
      <h2 class="section-title">Experience</h2>
      <a class="see-all" href="/resume">Full resume <Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="role-grid">
      {roles.map((r) => <RoleCard role={r} />)}
    </div>
  </section>

  <section class="section wrap about-teaser">
    <div class="about-photos">
      {teaserPhotos.map((ph) => <PhotoSlot photo={ph} ratio="4 / 5" sizes="(max-width: 760px) 50vw, 280px" />)}
    </div>
    <div class="about-text">
      <p class="eyebrow">About me</p>
      <h2 class="hi">
        Hi, I'm Yacoub.
        <span class="hi-face"><PhotoSlot photo={headshot} round sizes="64px" /></span>
      </h2>
      <p class="lede">{teaser}</p>
      <a class="btn" href="/about">More about me <Icon name="arrow-right" size={16} /></a>
    </div>
  </section>

  <section id="contact" class="section wrap contact">
    <h2 class="section-title">Contact</h2>
    <a class="li-card" href={profile.linkedin} rel="me noopener" target="_blank">
      <span class="li-logo"><Icon name="brand-linkedin" size={30} /></span>
      <span class="li-text">
        <span class="li-name">{profile.name}</span>
        <span class="li-sub">{profile.program}</span>
      </span>
      <span class="li-cta">View LinkedIn profile <Icon name="arrow-up-right" size={16} /></span>
    </a>
    <dl class="contact-grid">
      <div><dt class="meta">Email</dt><dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd></div>
      <div><dt class="meta">GitHub</dt><dd><a href={profile.github}>github.com/ycouby77</a></dd></div>
      <div><dt class="meta">Based in</dt><dd>{profile.location}</dd></div>
    </dl>
  </section>
</Base>

<script>
  // Keep the hero's title block in step with the 3D model on screen.
  const media = document.querySelector('[data-hero-media]');
  media?.addEventListener('viewerchange', (e) => {
    const i = (e as CustomEvent<{ index: number }>).detail.index;
    media.querySelectorAll<HTMLElement>('[data-hero-caption]').forEach((c, j) => (c.hidden = j !== i));
  });
</script>

<style>
  /* Night scene behind the hero; the forest horizon sits along its bottom edge.
     Kept short so the project cards start near the fold. */
  .hero-band {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-band .hero {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(7rem, 18vh, 11rem);
  }
  /* Availability: a real status, so it gets a small steady status dot. */
  .avail::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    vertical-align: 0.1em;
  }
  .hero h1 em {
    font-style: italic;
    color: #cfe9da;
  }
  .hero {
    padding-block: clamp(2rem, 5vw, 3.5rem) 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: center;
  }
  .hero-text {
    display: grid;
    gap: 1.25rem;
  }
  h1 {
    font-size: clamp(2.6rem, 5.6vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .intro {
    margin: 0;
    color: var(--ink-2);
    font-size: 1.1rem;
    max-width: 44ch;
    text-wrap: pretty;
  }
  .hero-media {
    margin: 0;
  }
  .hero-caption {
    display: block;
    text-decoration: none;
  }
  [data-hero-caption][hidden] {
    display: none;
  }
  .icon-btn :global(svg) {
    margin-left: -0.15rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* Card grids */
  .work {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .see-all:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .card-group + .card-group {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .group-title {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .card-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.25rem);
  }
  .role-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1rem;
  }

  /* About preview */
  .about-teaser {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    border-top: 1px solid var(--line);
  }
  .about-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .about-photos > :global(:nth-child(2)) {
    margin-top: 3rem;
  }
  .about-text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .hi {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
  }
  .hi-face {
    width: 64px;
    flex: none;
  }
  .about-text .lede {
    margin: 0;
  }

  /* Contact */
  .contact {
    border-top: 1px solid var(--line);
  }
  .contact .section-title {
    margin-bottom: 2rem;
  }
  .li-card {
    border-radius: var(--radius);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.25rem;
    max-width: 760px;
    margin-bottom: 2rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    text-decoration: none;
  }
  .li-card:hover {
    border-color: var(--accent);
    color: inherit;
  }
  .li-logo {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: #0a66c2;
    color: #fff;
  }
  .li-text {
    display: grid;
    gap: 0.15rem;
  }
  .li-name {
    font-weight: 500;
    font-size: 1.1rem;
  }
  .li-sub {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .li-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--accent);
    font-weight: 500;
    font-size: 0.92rem;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
    margin: 0;
  }
  .contact-grid dd {
    margin: 0.25rem 0 0;
    font-size: 1.05rem;
  }
  .contact-grid a {
    display: inline-block;
    padding-block: 0.4rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-teaser {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 1100px) {
    .card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .card-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .li-card {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .li-cta {
      grid-column: 1 / -1;
    }
  }
</style>
