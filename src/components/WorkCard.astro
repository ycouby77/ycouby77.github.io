---
// Project card: big photo, context badge, status chip, title, a few tags.
// Used on the home page grid and on /projects (where data-categories drives the filter).
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  // 'wide' spans the full grid width with a letterbox image.
  wide?: boolean;
  eager?: boolean;
}
const { project, wide = false, eager = false } = Astro.props;
const { data } = project;
const pic = data.card === 'text' ? undefined : (data.cardImage ?? data.cover ?? data.gallery[0]);
const matte = pic && 'matte' in pic ? pic.matte : undefined;
const href = `/projects/${project.id}`;
---

<article class:list={['work-card', { wide, compact: !pic }]} data-categories={data.categories.join(',')}>
  {
    pic ? (
      <a class:list={['shot', { matted: matte }]} href={href} tabindex="-1" aria-hidden="true" data-tilt style={matte ? `--matte: ${matte}` : undefined}>
        <Image
          src={pic.src}
          alt=""
          widths={wide ? [800, 1200, 1700] : [560, 900, 1200]}
          sizes={wide ? '(max-width: 1720px) 100vw, 1680px' : '(max-width: 760px) 100vw, 50vw'}
          quality={88}
          loading={eager ? 'eager' : 'lazy'}
        />
        <span class="badge">{data.context}</span>
      </a>
    ) : (
      // No photo yet: a short text-only card instead of an empty image box.
      <p class="badge inline">{data.context}</p>
    )
  }
  <div class="text">
    {data.status && <p class="status">{data.status}</p>}
    <h3><a href={href}>{data.title}</a></h3>
    {!pic && <p class="blurb">{data.summary}</p>}
    <ul class="tags">
      {data.disciplines.slice(0, 3).map((d) => <li>{d}</li>)}
    </ul>
  </div>
</article>

<style>
  .work-card {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: rgb(16 19 22 / 0.55);
    transition: border-color 0.25s ease, background 0.25s ease;
  }
  .work-card:hover {
    border-color: var(--line-strong);
    background: rgb(16 19 22 / 0.8);
  }
  .work-card[hidden] {
    display: none;
  }
  .shot {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--img-bg);
  }
  .wide .shot {
    aspect-ratio: 21 / 9;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .work-card:hover .shot :global(img) {
    transform: scale(1.03);
  }
  .matted {
    background: var(--matte);
  }
  .matted :global(img) {
    object-fit: contain;
    padding: 6%;
  }
  .compact {
    align-self: start;
    padding-top: 1.1rem;
  }
  .badge.inline {
    position: static;
    justify-self: start;
    margin: 0 0 0 0.4rem;
  }
  .blurb {
    margin: 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .badge {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 1;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgb(3 4 4 / 0.78);
    border: 1px solid rgb(255 255 255 / 0.12);
    backdrop-filter: blur(6px);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .text {
    display: grid;
    gap: 0.45rem;
    padding-inline: 0.4rem;
  }
  .status {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  h3 {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.15;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
