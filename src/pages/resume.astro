---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import resume1 from '../assets/resume/resume-1.png';
import cv1 from '../assets/resume/cv-1.png';
import cv2 from '../assets/resume/cv-2.png';

// Page images are rendered from the PDFs (200 dpi) so they read the same on every
// device; phones often can't show an embedded PDF inline.
const resumePages = [
  { src: resume1, alt: 'One-page resume: summary, education at Western University, experience at the ARM Lab, Western Engineering Autopilot, and Western Formula Racing, projects, and skills.' },
];
const cvPages = [
  { src: cv1, alt: 'CV page 1: education, experience at the ARM Lab, Western Engineering Autopilot, and Western Formula Racing, and leadership roles.' },
  { src: cv2, alt: 'CV page 2: projects, skills, and awards and certifications.' },
];
const file = (path: string) => path.split('/').pop();
---

<Base title="Resume" description={`Resume and CV of ${profile.name}, ${profile.program}.`}>
  <section class="wrap resume">
    <header class="head">
      <div>
        <h1>Resume</h1>
        <p class="sub">One page, the short version.</p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={profile.resumePdf} download={file(profile.resumePdf)}><Icon name="download" /> Download resume</a>
        <a class="btn" href={profile.resumePdf} target="_blank" rel="noopener">Open in new tab</a>
      </div>
    </header>
    <div class="pages">
      {
        resumePages.map((p) => (
          <figure class="page">
            <Image src={p.src} alt={p.alt} widths={[700, 1100, 1700]} sizes="(max-width: 900px) 100vw, 850px" loading="eager" quality={90} />
          </figure>
        ))
      }
    </div>

    <details class="cv">
      <summary>
        <span class="cv-text">
          <span class="cv-title">CV</span>
          <span class="sub">The detailed version: every role, project, and skill (2 pages).</span>
        </span>
        <span class="btn cv-toggle"><span class="when-closed">Preview CV</span><span class="when-open">Hide CV</span></span>
      </summary>
      <div class="cv-body">
        <div class="actions">
          <a class="btn btn-primary" href={profile.cvPdf} download={file(profile.cvPdf)}><Icon name="download" /> Download CV</a>
          <a class="btn" href={profile.cvPdf} target="_blank" rel="noopener">Open in new tab</a>
        </div>
        <div class="pages">
          {
            cvPages.map((p) => (
              <figure class="page">
                <Image src={p.src} alt={p.alt} widths={[700, 1100, 1700]} sizes="(max-width: 900px) 100vw, 850px" quality={90} />
              </figure>
            ))
          }
        </div>
      </div>
    </details>
    <p class="cv-direct">
      Just want the file? <a href={profile.cvPdf} download={file(profile.cvPdf)}>Download the CV</a>
    </p>
  </section>
</Base>

<style>
  .resume {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .head,
  .pages,
  .cv,
  .cv-direct {
    max-width: 850px;
    margin-inline: auto;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
  }
  .sub {
    margin: 0.35rem 0 0;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pages {
    display: grid;
    gap: 1.5rem;
  }
  .page {
    border-radius: var(--radius);
    margin: 0;
    background: #fff;
    border: 1px solid var(--line-strong);
    box-shadow: 0 24px 60px -30px rgb(0 0 0 / 0.8);
  }
  .page :global(img) {
    width: 100%;
    height: auto;
  }

  .cv {
    margin-top: 3.5rem;
    border-top: 1px solid var(--line-strong);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .cv-title {
    display: block;
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .cv-toggle {
    pointer-events: none; /* the whole summary row is the control */
  }
  summary:hover .cv-toggle,
  summary:focus-visible .cv-toggle {
    border-color: var(--accent);
    color: var(--accent);
  }
  .when-open,
  .cv[open] .when-closed {
    display: none;
  }
  .cv[open] .when-open {
    display: inline;
  }
  .cv-body {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 1rem;
  }
  .cv-direct {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .cv[open] + .cv-direct {
    display: none;
  }
</style>
