---
// The forest horizon along the bottom of the home hero: a far ridge, two treelines, a
// small observatory with lit windows, survey contours on the ground, and fireflies.
// Layers shift by different amounts with the pointer and with scroll (parallax).
// Decorative only; static for reduced motion; paused when off screen.
---

<canvas class="hero-scene" aria-hidden="true" data-hero-scene></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-scene]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const host = canvas.parentElement!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    let W = 0;
    let H = 0;
    let mx = 0; // pointer offset, -0.5..0.5
    // Pointer position inside the hero (px); pointerIn is false when the pointer is elsewhere.
    let px = 0;
    let py = 0;
    let pointerIn = false;
    let scatterUntil = 0; // after a click, the cursor stops attracting for a moment
    // ox/oy: current offset toward the cursor; vx/vy: scatter velocity after a click.
    const flies = Array.from({ length: 22 }, () => ({
      x: rand(0, 1),
      y: rand(0.78, 0.97),
      p: rand(0, 7),
      sp: rand(0.3, 1),
      ox: 0,
      oy: 0,
      vx: 0,
      vy: 0,
      lx: 0,
      ly: 0,
    }));
    const PULL = 240; // px: fireflies closer than this drift toward the cursor

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = canvas!.clientWidth;
      H = canvas!.clientHeight;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // Deterministic pseudo-random so the treeline doesn't change on resize.
    const hash = (n: number) => {
      const x = Math.sin(n * 127.1) * 43758.5453;
      return x - Math.floor(x);
    };

    function treeline(baseY: number, height: number, spacing: number, seed: number, color: string, shift: number) {
      ctx!.fillStyle = color;
      const start = -spacing * 2 + (shift % spacing);
      for (let i = 0, x = start; x < W + spacing * 2; i++, x += spacing * (0.7 + 0.6 * hash(i + seed))) {
        const h = height * (0.55 + 0.45 * hash(i * 3.3 + seed));
        const w = h * (0.2 + 0.06 * hash(i + seed * 2));
        const y = baseY + Math.sin(i * 0.9 + seed) * 5;
        // Layered spruce silhouette: three stacked triangles.
        for (let k = 0; k < 3; k++) {
          const top = y - h + (k * h) / 4;
          const half = w * (0.55 + k * 0.25);
          ctx!.beginPath();
          ctx!.moveTo(x, top);
          ctx!.lineTo(x - half, top + h * 0.45);
          ctx!.lineTo(x + half, top + h * 0.45);
          ctx!.fill();
        }
      }
      ctx!.fillRect(-10, baseY, W + 20, H - baseY + 10);
    }

    function draw(t: number) {
      const rect = host.getBoundingClientRect();
      const sy = Math.max(0, -rect.top); // how far the hero has scrolled up
      ctx!.clearRect(0, 0, W, H);

      // Far ridge.
      ctx!.fillStyle = '#0b1013';
      ctx!.beginPath();
      ctx!.moveTo(-10, H);
      for (let x = -10; x <= W + 10; x += 8) {
        const y = H * 0.74 + Math.sin(x * 0.006 + 1) * 22 + Math.sin(x * 0.017 + 3) * 10 - sy * 0.04;
        ctx!.lineTo(x + mx * 6, y);
      }
      ctx!.lineTo(W + 10, H);
      ctx!.fill();

      treeline(H * 0.82 - sy * 0.08, Math.min(70, H * 0.11), 26, 2, '#070a0c', mx * 12);

      // Observatory: dome, slit, telescope, warm windows and their glow.
      const ox = W * 0.62 + mx * 14;
      const oy = H * 0.82 - sy * 0.08 - 34;
      const glow = ctx!.createRadialGradient(ox, oy + 18, 2, ox, oy + 18, 90);
      glow.addColorStop(0, 'rgba(255, 200, 120, 0.20)');
      glow.addColorStop(1, 'rgba(255, 200, 120, 0)');
      ctx!.fillStyle = glow;
      ctx!.fillRect(ox - 100, oy - 70, 200, 170);
      ctx!.fillStyle = '#0b0f11';
      ctx!.fillRect(ox - 28, oy, 56, 36);
      ctx!.beginPath();
      ctx!.arc(ox, oy, 28, Math.PI, 0);
      ctx!.fill();
      ctx!.save();
      ctx!.translate(ox + 4, oy - 16);
      ctx!.rotate(-0.55);
      ctx!.fillRect(-3.5, -26, 7, 26);
      ctx!.restore();
      const lamp = reduce ? 0.95 : 0.85 + 0.15 * Math.sin(t * 0.003);
      ctx!.fillStyle = `rgba(255, 207, 138, ${lamp})`;
      ctx!.fillRect(ox - 17, oy + 12, 8, 9);
      ctx!.fillRect(ox + 8, oy + 12, 8, 9);

      treeline(H * 0.9 - sy * 0.14, Math.min(96, H * 0.15), 38, 7, '#030505', mx * 26);

      // Survey contours across the ground.
      ctx!.save();
      ctx!.strokeStyle = 'rgba(126, 240, 196, 0.13)';
      ctx!.lineWidth = 1;
      for (let i = 0; i < 6; i++) {
        ctx!.beginPath();
        for (let x = 0; x <= W; x += 10) {
          const y = H * 0.935 + i * 7 + Math.sin(x * 0.012 + i * 0.8 + (reduce ? 0 : t * 0.0003)) * 3;
          x ? ctx!.lineTo(x, y) : ctx!.moveTo(x, y);
        }
        ctx!.stroke();
      }
      ctx!.restore();

      // Fireflies.
      // Near the cursor they drift toward it and stay lit; a click scatters them.
      if (!W || !H) return;
      for (const f of flies) {
        const bx = (((f.x * W + Math.sin(t * 0.0004 * f.sp + f.p) * 30 + mx * 26) % W) + W) % W;
        const by = f.y * H + Math.cos(t * 0.0006 * f.sp + f.p) * 8 - sy * 0.14;
        let tx = 0;
        let ty = 0;
        let near = 0;
        if (pointerIn && t > scatterUntil) {
          const d = Math.hypot(px - bx, py - by);
          if (d < PULL) {
            near = 1 - d / PULL;
            // Circle the cursor loosely instead of piling onto it.
            const a = t * 0.0012 * f.sp + f.p;
            const ring = 26 + 18 * f.sp;
            tx = (px + Math.cos(a) * ring - bx) * near * 0.85;
            ty = (py + Math.sin(a) * ring * 0.6 - by) * near * 0.85;
          }
        }
        f.ox += (tx - f.ox) * 0.035 + f.vx;
        f.oy += (ty - f.oy) * 0.035 + f.vy;
        f.vx *= 0.9;
        f.vy *= 0.9;
        if (!Number.isFinite(f.ox + f.oy)) f.ox = f.oy = f.vx = f.vy = 0;
        const fx = bx + f.ox;
        const fy = by + f.oy;
        f.lx = fx;
        f.ly = fy;
        const blink = reduce ? 0.6 : Math.max(0, Math.sin(t * 0.002 * f.sp + f.p));
        const on = Math.max(blink, near * 0.95);
        if (on < 0.2) continue;
        const r = 8 + near * 3;
        const g = ctx!.createRadialGradient(fx, fy, 0, fx, fy, r);
        g.addColorStop(0, `rgba(200, 255, 150, ${on * 0.9})`);
        g.addColorStop(1, 'rgba(200, 255, 150, 0)');
        ctx!.fillStyle = g;
        ctx!.fillRect(fx - r, fy - r, r * 2, r * 2);
      }
    }

    resize();
    new ResizeObserver(resize).observe(canvas);
    if (reduce) {
      draw(0);
    } else {
      host.addEventListener('pointermove', (e) => {
        const r = host.getBoundingClientRect();
        mx = (e.clientX - r.left) / r.width - 0.5;
        if (e.pointerType === 'mouse') {
          px = e.clientX - r.left;
          py = e.clientY - r.top;
          pointerIn = true;
        }
      });
      host.addEventListener('pointerleave', () => (pointerIn = false));
      host.addEventListener('pointerdown', (e) => {
        if ((e.target as Element | null)?.closest('a, button')) return;
        const r = host.getBoundingClientRect();
        const cx = e.clientX - r.left;
        const cy = e.clientY - r.top;
        for (const f of flies) {
          const dx = f.lx - cx;
          const dy = f.ly - cy;
          const d = Math.hypot(dx, dy);
          if (d > PULL * 1.2) continue;
          const k = (1 - d / (PULL * 1.2)) * 9 + 2;
          f.vx += (dx / (d || 1)) * k;
          f.vy += (dy / (d || 1)) * k;
        }
        scatterUntil = performance.now() + 900;
      });
      let visible = true;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(host);
      const loop = (t: number) => {
        if (visible && !document.hidden) draw(t);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>

<style>
  .hero-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>
