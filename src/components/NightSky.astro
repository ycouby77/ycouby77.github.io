---
// Site-wide night sky: a fixed canvas behind every page with twinkling stars, a faint
// star-chart grid (strongest at the top of the page), and the odd shooting star.
// Stars drift slower than the page scrolls (parallax). Static for reduced motion,
// paused when the tab is hidden.
---

<canvas class="night-sky" aria-hidden="true" data-night-sky></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-night-sky]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    let W = 0;
    let H = 0;
    type Star = { x: number; y: number; s: number; t: number; depth: number };
    let stars: Star[] = [];

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round((W * H) / 4200);
      stars = Array.from({ length: count }, () => ({
        x: rand(0, W),
        y: rand(0, H * 1.6), // taller than the screen so parallax has stars to reveal
        s: rand(0.3, 1.4),
        t: rand(0, Math.PI * 2),
        depth: rand(0.03, 0.12), // how much this star moves with scroll
      }));
    }

    let shoot: { x: number; y: number; l: number } | null = null;

    function draw(t: number) {
      const scroll = window.scrollY;
      ctx!.clearRect(0, 0, W, H);

      // Star-chart grid: rings and meridians around a pole off the top-right corner,
      // turning very slowly; fades as you scroll away from the top.
      const chartAlpha = Math.max(0.025, 0.09 * (1 - scroll / (H * 1.5)));
      const cx = W * 0.82;
      const cy = H * 0.08 - scroll * 0.05;
      const rot = reduce ? 0 : t * 0.000012;
      ctx!.save();
      ctx!.globalAlpha = chartAlpha;
      ctx!.strokeStyle = '#9fd3ff';
      ctx!.lineWidth = 1;
      for (let i = 1; i <= 8; i++) {
        ctx!.beginPath();
        ctx!.arc(cx, cy, i * 120, 0, Math.PI * 2);
        ctx!.stroke();
      }
      for (let k = 0; k < 12; k++) {
        const a = (k * Math.PI) / 6 + rot;
        ctx!.beginPath();
        ctx!.moveTo(cx, cy);
        ctx!.lineTo(cx + Math.cos(a) * 2000, cy + Math.sin(a) * 2000);
        ctx!.stroke();
      }
      ctx!.restore();

      for (const s of stars) {
        const y = (((s.y - scroll * s.depth) % (H * 1.6)) + H * 1.6) % (H * 1.6);
        if (y > H) continue;
        const tw = reduce ? 0.8 : 0.55 + 0.45 * Math.sin(t * 0.0016 + s.t);
        ctx!.fillStyle = `rgba(225, 236, 255, ${0.25 + 0.6 * tw})`;
        ctx!.fillRect(s.x, y, s.s, s.s);
      }

      if (!reduce) {
        if (!shoot && Math.random() < 0.0025) shoot = { x: rand(W * 0.2, W), y: rand(0, H * 0.35), l: 0 };
        if (shoot) {
          shoot.l += 11;
          const len = Math.min(shoot.l, 140);
          const hx = shoot.x - shoot.l * 0.9;
          const hy = shoot.y + shoot.l * 0.35;
          ctx!.strokeStyle = `rgba(230, 240, 255, ${Math.max(0, 1 - shoot.l / 300)})`;
          ctx!.lineWidth = 1.2;
          ctx!.beginPath();
          ctx!.moveTo(hx, hy);
          ctx!.lineTo(hx + len * 0.9, hy - len * 0.35);
          ctx!.stroke();
          if (shoot.l > 300) shoot = null;
        }
      }
    }

    resize();
    window.addEventListener('resize', resize);
    if (reduce) {
      draw(0); // one still frame, no motion
    } else {
      const loop = (t: number) => {
        if (!document.hidden) draw(t);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>

<style>
  .night-sky {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>
