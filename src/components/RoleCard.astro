---
// Experience card: dates and status, role, organization, one line on what I did.
// Links to the related project page, or to the full entry on /resume.
import type { Role } from '../data/profile';

interface Props {
  role: Role;
}
const { role } = Astro.props;
const href = role.project ? `/projects/${role.project}` : `/resume#${role.id}`;
---

<article class="role-card">
  <div class="top">
    <span class="when">{role.period}</span>
    <span class:list={['status', { current: role.status === 'Current' }]}>{role.status}</span>
  </div>
  <h3><a href={href}>{role.title}</a></h3>
  <p class="org">{role.orgShort}</p>
  <p class="point">{role.points[0]}</p>
  <span class="more" aria-hidden="true">{role.project ? 'See the project' : 'Read more'} →</span>
</article>

<style>
  .role-card {
    position: relative;
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.25rem 1.3rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    background: rgb(16 19 22 / 0.55);
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }
  .role-card:hover {
    border-color: rgb(126 240 196 / 0.4);
    background: rgb(16 19 22 / 0.85);
    transform: translateY(-2px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 0.35rem;
  }
  .status {
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    white-space: nowrap;
  }
  .status.current {
    color: var(--accent);
    border-color: rgb(126 240 196 / 0.4);
  }
  h3 {
    font-size: 1.2rem;
    line-height: 1.2;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .org {
    margin: 0;
    color: var(--warm);
    font-size: 0.92rem;
  }
  .point {
    margin: 0.35rem 0 0;
    color: var(--ink-2);
    font-size: 0.93rem;
    line-height: 1.5;
  }
  .more {
    margin-top: 0.5rem;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 500;
  }
</style>
